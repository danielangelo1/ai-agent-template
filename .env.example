# Copy to .env and fill in real values. Never commit .env — see
# .claude/hooks/guard-destructive.sh, which also blocks the agent from
# reading .env directly in-session.

# Sentry (optional — src/main.tsx only initializes Sentry when this is set).
# Must be VITE_-prefixed for Vite to expose it to client code.
VITE_SENTRY_DSN=
